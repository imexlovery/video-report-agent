# Project Pi settings. Credentials never fall back to ~/.pi/agent.
# Custom provider definitions: config/pi/models.json
# For ordinary Zhipu BigModel API: PI_PROVIDER=zhipu, PI_MODEL=glm-5.2
PI_PROVIDER=deepseek
PI_MODEL=deepseek-flash
# Set your key here. For Pi login use: PI_CODING_AGENT_DIR="$PWD/config/pi" pi
PI_API_KEY=
# Local CLI quickstart: run Pi on this machine without Docker or a task cleaner.
# Pi's file and shell tools use your local user permissions; there is no task sandbox.
PI_TASK_ISOLATION=local
# To enable task isolation, set PI_TASK_ISOLATION=docker and prepare a compatible
# application image, running Docker daemon and healthy cleaner with the same scope.
# Omitting PI_TASK_ISOLATION defaults to docker; hosted Public mode enforces docker.
# PI_TASK_IMAGE=video-report-agent:linux-amd64
# PI_TASK_SCOPE=video-report
# PI_TASK_MEMORY=2g
# PI_TASK_CPUS=2
# Opt-in report inspection inside the same Pi agent (max two checks).
# Keep off until the local A/B results justify the extra calls for your model.
REPORT_REVIEW=0
# Compact Agent trace is always retained. Full RPC stream is opt-in for debugging.
PI_TRACE_FULL=0
# Terminal runs' opt-in raw streams expire during cleanup; 0 keeps them indefinitely.
PI_TRACE_FULL_MAX_AGE_DAYS=7

# Keep terminal runs' media for seven days; reports and transcripts are retained.
MEDIA_KEEP_LAST=0
MEDIA_MAX_AGE_DAYS=7

# Media understanding: resolve backend before selecting its default model.
ASR_BACKEND=mlx
# Optional override; omit to use the selected backend's default:
# mlx: mlx-community/whisper-large-v3-turbo
# paraformer: paraformer-v2, fun-asr, fun-asr-2025-08-25,
# fun-asr-2025-11-07, fun-asr-mtl, fun-asr-mtl-2025-08-25
# ASR_MODEL=
OCR_BACKEND=rapidocr
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
